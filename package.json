{
  "name": "greywake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "xvfb-run -a node scripts/verify-browser.mjs",
    "test:orientation": "xvfb-run -a node scripts/verify-orientation.mjs",
    "profile:renderer": "xvfb-run -a node scripts/profile-renderer.mjs",
    "ai:simulate": "node scripts/simulate-ai.mjs",
    "check": "biome check src scripts tests",
    "test:ai-lab": "xvfb-run -a node scripts/verify-ai-lab.mjs",
    "test:water": "node --test tests/water.test.js",
    "test:water-shaders": "node scripts/verify-water-shaders.mjs",
    "test:water-driver": "node scripts/verify-water-shaders.mjs && python3 scripts/verify-water-glsl.py",
    "capture:water-native": "node scripts/capture-water-native.mjs && python3 scripts/render-water-native.py",
    "test:water-browser": "xvfb-run -a node scripts/verify-water-browser.mjs",
    "test:boot": "xvfb-run -a node scripts/verify-boot.mjs",
    "test:boot:browsers": "xvfb-run -a node scripts/verify-boot-browsers.mjs",
    "test:boot:dev": "xvfb-run -a node scripts/verify-boot-dev.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
